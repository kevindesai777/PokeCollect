<?xml version="1.0" encoding="utf-8"?>
<!--
Back up and transfer only the database (the collection). The model, unpacked from the Play AI
pack into internal storage (584 MB), would push the app far past Auto Backup's 25 MB limit, and
then nothing at all is backed up. Play delivers the model again on a new phone anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
