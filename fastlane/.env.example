# Copy to fastlane/.env (gitignored) and fill in. Keep the key files outside the repo.

# Apple Developer Team ID (also what TEAM_ID in iosApp/Configuration/Config.xcconfig stands for).
TEAM_ID=

# Google Play: JSON key of a Google Cloud service account that is invited in Play Console
# (Users and permissions) with release rights for PokeCollect.
PLAY_JSON_KEY=

# App Store Connect API key (Users and Access > Integrations > App Store Connect API, role App Manager).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Only needed when gemma_pack/src/main/assets/ has no model yet (see scripts/stage_model.sh).
GEMMA_MODEL=
